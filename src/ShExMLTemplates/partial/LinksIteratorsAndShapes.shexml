ITERATOR components_iterator <jsonpath: $.data.links.items[*]> {
    PUSHED_FIELD source_id <source.id>
    PUSHED_FIELD source_type <source.type>
    ITERATOR loc_org <[?(@.field=='locationOfOriginals' && @.source.id)]> {
        PUSHED_FIELD identifier <id>
        PUSHED_FIELD description <description>
        ITERATOR targets <targets[*]> {
            POPPED_FIELD subject_id <holding_id>
            FIELD target_id <id>
            FIELD type <type>
            POPPED_FIELD source_id <source_id>
            POPPED_FIELD source_type <source_type>
            POPPED_FIELD id <identifier>
            POPPED_FIELD description <description>
        }
    }
    ITERATOR loc_cop <[?(@.field=='locationOfCopies' && @.source.id)]> {
        PUSHED_FIELD identifier <id>
        PUSHED_FIELD description <description>
        ITERATOR targets <targets[*]> {
            POPPED_FIELD subject_id <holding_id>
            FIELD target_id <id>
            FIELD type <type>
            POPPED_FIELD source_id <source_id>
            POPPED_FIELD source_type <source_type>
            POPPED_FIELD id <identifier>
            POPPED_FIELD description <description>
        }
    }
    ITERATOR creators <[?(@.body[0].type=='creator')]> {
        FIELD unit_id <targets[?(@.type=='DocumentaryUnit')].id>
        FIELD cb_id <targets[?(@.type=='HistoricalAgent')].id> 
    }
}

EXPRESSION links <links_file.components_iterator>

################################################
### Copy links for holdings and repositories ###
################################################

## Location of Originals ##
# unit to unit or unit to institution
ehri:HoldingLocationOfOriginals ehri_units:[links.loc_org.targets.source_id IF validators.areSourceAndTargetDifferentAndIsSubjectDocumentaryUnit(links.loc_org.targets.source_id, links.loc_org.targets.target_id, links.loc_org.targets.source_type)] {
    rico:thingIsSourceOfRelation @ehri:IsCopyOfLocOrg ;
    #completion of hasCopy links
    rico:thingIsTargetOfRelation ehri_has_copy_relations:[links.loc_org.targets.id] ;
}
# institution to unit or institution to institution
ehri:InstitutionLocationOfOriginals ehri_institutions:[links.loc_org.targets.source_id IF validators.areSourceAndTargetDifferentAndIsSubjectInstitution(links.loc_org.targets.source_id, links.loc_org.targets.target_id, links.loc_org.targets.source_type)] {
    rico:thingIsSourceOfRelation @ehri:IsCopyOfLocOrg ;
    #completion of hasCopy links
    rico:thingIsTargetOfRelation ehri_has_copy_relations:[links.loc_org.targets.id] ;
}
#n-ary relation for ehri:IsCopyOf location of originals
ehri:IsCopyOfLocOrg ehri_is_copy_of_relations:[links.loc_org.targets.id] {
    a ehri:IsCopyOfRelation ;
    rico:generalDescription [links.loc_org.targets.description] ;
    # The object is a documentary unit
    rico:relationHasTarget ehri_units:[links.loc_org.targets.target_id IF validators.isDocumentaryUnit(links.loc_org.targets.type)] ;
    # The object is an institution
    rico:relationHasTarget ehri_institutions:[links.loc_org.targets.target_id IF validators.isInstitution(links.loc_org.targets.type)] ;
    # The subject is a documentary unit
    rico:relationHasSource ehri_units:[links.loc_org.targets.source_id IF validators.isDocumentaryUnit(links.loc_org.targets.source_type)] ;
    # The subject is an institution
    rico:relationHasSource ehri_institutions:[links.loc_org.targets.source_id IF validators.isInstitution(links.loc_org.targets.source_type)] ;
}
# unit to unit or institution to unit (inverse)
ehri:HoldingLocationOfOriginalsInverse ehri_units:[links.loc_org.targets.target_id IF validators.areSourceAndTargetDifferentAndIsSubjectDocumentaryUnit(links.loc_org.targets.source_id, links.loc_org.targets.target_id, links.loc_org.targets.type)] {
    rico:thingIsSourceOfRelation @ehri:HasCopyLocOrg ;
    #completion of isCopyOf links
    rico:thingIsTargetOfRelation ehri_is_copy_of_relations:[links.loc_org.targets.id] ;
}
# unit to institution or institution to institution (inverse)
ehri:InstitutionLocationOfOriginalsInverse ehri_institutions:[links.loc_org.targets.target_id IF validators.areSourceAndTargetDifferentAndIsSubjectInstitution(links.loc_org.targets.source_id, links.loc_org.targets.target_id, links.loc_org.targets.type)] {
    rico:thingIsSourceOfRelation @ehri:HasCopyLocOrg ;
    #completion of isCopyOf links
    rico:thingIsTargetOfRelation ehri_is_copy_of_relations:[links.loc_org.targets.id] ;
}
#n-ary relation for ehri:HasCopy location of originals
ehri:HasCopyLocOrg ehri_has_copy_relations:[links.loc_org.targets.id] {
    a ehri:HasCopyRelation ;
    rico:generalDescription [links.loc_org.targets.description] ;
    # The object is a documentary unit
    rico:relationHasTarget ehri_units:[links.loc_org.targets.source_id IF validators.isDocumentaryUnit(links.loc_org.targets.source_type)] ;
    # The object is an institution
    rico:relationHasTarget ehri_institutions:[links.loc_org.targets.source_id IF validators.isInstitution(links.loc_org.targets.source_type)] ;
    # The subject is a documentary unit
    rico:relationHasSource ehri_units:[links.loc_org.targets.target_id IF validators.isDocumentaryUnit(links.loc_org.targets.source_type)] ;
    # The subject is an institution
    rico:relationHasSource ehri_institutions:[links.loc_org.targets.target_id IF validators.isInstitution(links.loc_org.targets.source_type)] ;
}

## Location of Copies ##
# institution to unit or institution to institution
